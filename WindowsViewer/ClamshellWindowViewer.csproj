<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows viewer for the Clamshell window-stream protocol (PROTOCOL.md
         "Window Handoff v1"). Connects to a host's window-stream WebSocket,
         decodes AVCC H.264/HEVC, renders in a native window sized to the
         source. WinExe so double-click launches with no console; the
         verify mode (see Program.cs) still writes to stderr/a log file
         via Log.cs, same pattern as WindowsServer. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ClamshellWindowViewer</AssemblyName>
    <RootNamespace>Clamshell</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same package the host uses for encode (Vortice.MediaFoundation),
         reused here for decode via the built-in Windows H.264/HEVC decoder
         MFTs (no codec install required, no FFmpeg dependency). -->
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
  </ItemGroup>

</Project>
