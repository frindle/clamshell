<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: runs from the system tray, no console window. -->
    <OutputType>WinExe</OutputType>
    <!-- Windows-only: DXGI capture, Media Foundation, WASAPI, SendInput, Win32 clipboard.
         Versioned moniker (not bare net8.0-windows) so the C#/WinRT source
         generator projects Windows.Graphics.Capture for window-handoff
         capture (WindowCaptureSelfTest.cs) -- 19041.0 is the floor for
         reliable per-window GraphicsCaptureItem creation. Raises this app's
         minimum Windows version to 10 20H1 (May 2020 Update) / Server 2022. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ClamshellServer</AssemblyName>
    <RootNamespace>Clamshell</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NotifyIcon/ContextMenuStrip/Form for the tray icon and Settings window. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Same artwork as the Mac app's AppIcon.icns, repackaged as .ico (see
         WindowsServer/AppIcon.ico) — shows up in Explorer, the taskbar,
         Alt-Tab, and Start Menu shortcuts. TrayApp reads it back off this
         same exe at runtime for the NotifyIcon, so there's one source of truth. -->
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- SharpDX successor: DXGI Desktop Duplication capture + Direct3D11 + Media Foundation encode. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
    <!-- WASAPI loopback system-audio capture. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
