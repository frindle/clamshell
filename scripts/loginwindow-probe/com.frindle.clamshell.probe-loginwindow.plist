<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.frindle.clamshell.probe-loginwindow</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Clamshell.app/Contents/MacOS/Clamshell</string>
        <string>loginwindow-probe</string>
        <string>--label</string>
        <string>loginwindow</string>
    </array>
    <key>LimitLoadToSessionType</key><string>LoginWindow</string>
    <key>StartInterval</key><integer>60</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>/var/tmp/clamshell-probe/launchd-loginwindow.log</string>
    <key>StandardErrorPath</key><string>/var/tmp/clamshell-probe/launchd-loginwindow.log</string>
</dict>
</plist>
