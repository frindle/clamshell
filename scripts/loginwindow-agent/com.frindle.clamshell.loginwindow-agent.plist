<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template, shipped in Clamshell.app/Contents/Resources/loginwindow-agent/.
  `sudo clamshell loginwindow install` fills the placeholders and copies
  the result to /Library/LaunchAgents. Do not load this file by hand.

  Runs `Clamshell loginwindow-agent` in the login-window session only, from
  the root-owned copy of the app, with its own state folder (a root-only copy
  of the user's host key and trusted devices). The agent serves the stream
  while nobody is logged in and exits the moment someone logs in, so the
  normal app can take the same ports.
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.frindle.clamshell.loginwindow-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>__APP_BINARY__</string>
        <string>loginwindow-agent</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CLAMSHELL_STATE_DIR</key><string>__STATE_DIR__</string>
    </dict>
    <key>LimitLoadToSessionType</key><string>LoginWindow</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key><false/>
    </dict>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>StandardOutPath</key><string>__LOG__</string>
    <key>StandardErrorPath</key><string>__LOG__</string>
</dict>
</plist>
